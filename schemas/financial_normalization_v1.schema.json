{
  "$defs": {
    "FinancialContext": {
      "additionalProperties": false,
      "properties": {
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "period_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Type"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "scale": {
          "anyOf": [
            {
              "description": "Finite Decimal encoded as a string",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "reporting_scope": {
          "anyOf": [
            {
              "enum": [
                "separate",
                "consolidated"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reporting Scope"
        },
        "statement_type": {
          "anyOf": [
            {
              "enum": [
                "B01",
                "B02",
                "B03",
                "B09"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Statement Type"
        },
        "raw_item_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Item Label"
        },
        "mapped_item_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapped Item Code"
        }
      },
      "title": "FinancialContext",
      "type": "object"
    },
    "FinancialSourceReference": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "source_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Pointer"
        },
        "provenance_level": {
          "default": "page",
          "enum": [
            "page",
            "element",
            "cell"
          ],
          "title": "Provenance Level",
          "type": "string"
        }
      },
      "required": [
        "anchor"
      ],
      "title": "FinancialSourceReference",
      "type": "object"
    },
    "FinancialValue": {
      "additionalProperties": false,
      "properties": {
        "raw_value": {
          "title": "Raw Value",
          "type": "string"
        },
        "normalized_value": {
          "anyOf": [
            {
              "description": "Finite Decimal encoded as a string",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "status": {
          "enum": [
            "resolved",
            "uncertain",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "raw_value",
        "status"
      ],
      "title": "FinancialValue",
      "type": "object"
    },
    "RawPageIdentity": {
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "year": {
          "title": "Year",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "image": {
          "title": "Image",
          "type": "string"
        },
        "source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Ref"
        }
      },
      "required": [
        "symbol",
        "year",
        "page",
        "image"
      ],
      "title": "RawPageIdentity",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "$ref": "#/$defs/RawPageIdentity"
        },
        "element_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        },
        "table_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Id"
        },
        "cell_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Id"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Id"
        },
        "observed_bbox": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Bbox"
        },
        "proposed_bbox": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 4,
              "minItems": 4,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Bbox"
        },
        "status": {
          "enum": [
            "resolved",
            "uncertain",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "page",
        "status"
      ],
      "title": "SourceAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "financial_normalization_v1",
      "title": "Contract Version",
      "type": "string"
    },
    "value": {
      "$ref": "#/$defs/FinancialValue"
    },
    "context": {
      "$ref": "#/$defs/FinancialContext"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/FinancialSourceReference"
      },
      "title": "Provenance",
      "type": "array"
    },
    "financial_fact_verified": {
      "const": false,
      "default": false,
      "title": "Financial Fact Verified",
      "type": "boolean"
    }
  },
  "required": [
    "contract_version",
    "value",
    "context",
    "provenance"
  ],
  "title": "financial_normalization_v1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
