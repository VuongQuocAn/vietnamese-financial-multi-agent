# File mẫu; load_data_config đọc process environment, không tự đọc .env.
# Điền trong .env cục bộ, không commit giá trị bí mật.
GEMINI_API_KEY=
# TBD: model và backend cơ sở dữ liệu chưa được chọn.
GEMINI_MODEL=
DATABASE_URL=

# Đường dẫn cục bộ gợi ý, có thể thay bằng đường dẫn ngoài repository.
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
EVIDENCE_DATA_DIR=./data/evidence
ARTIFACTS_DIR=./artifacts

# Dataset local; M1-03a dùng đúng bốn key dưới đây, không fallback từ DATA_DIR.
# Input roots bắt buộc; relative paths tính từ project_root tuyệt đối.
# Default project_root chỉ từ source checkout; bản wheel cần truyền tường minh.
FINANCIAL_REPORT_DIR=data/raw/Financial_Report
FINANCIAL_OCR_DIR=data/processed/Financial_Report_OCR
# Output roots tùy chọn (bỏ key khi chưa cấu hình, không để rỗng).
# Không được overlap input/output khác theo lexical paths; không tự tạo thư mục.
NORMALIZED_DATA_DIR=data/normalized
CANONICAL_DATA_DIR=data/canonical

# Gemini: chỉ giá trị mẫu; key thật ở secrets ngoài repository.
GEMINI_API_KEY=replace-with-local-secret
GEMINI_MODEL=gemini-3.5-flash-lite

# W-03 Free Tier, server-only: chỉ cần key file, không project/policy/scope thủ công.
GEMINI_API_KEY_FILE=
WEB_GEMINI_RPM=15
WEB_GEMINI_RPD=500
WEB_GEMINI_TPM=250000
WEB_GEMINI_MAX_ATTEMPTS=3
WEB_GEMINI_COOLDOWN_SECONDS=60
WEB_STORAGE_ROOT=artifacts/web-demo-v1
WEB_MAX_UPLOAD_BYTES=52428800
WEB_MAX_PAGES=200
WEB_PREFLIGHT_CAPACITY=4
WEB_PREFLIGHT_BATCH_SIZE=4
WEB_PREFLIGHT_MAX_PAGES=200
WEB_PREFLIGHT_REQUEST_LIMIT=50
WEB_PREFLIGHT_DPI=150
WEB_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Local operator-controlled source reviews; corrected releases need a separate approval.
DOCUMENT_SOURCE_POLICY_ROOT=artifacts/source-quality
# Pin canonical policy fingerprint when deploying/moving real reviewed data.
# A configured missing store or a mismatched fingerprint fails startup and M6 closed.
DOCUMENT_SOURCE_POLICY_SHA256=

# REC-01: optional operator storage; configured missing selection fails startup.
# Default checkout location: artifacts/source-quality/active-releases.json.
# DOCUMENT_RELEASE_ROOT=artifacts/source-quality
# Gemini requires a manually supplied deadline of at least 10 seconds.
OCR_RECOVERY_TIMEOUT_SECONDS=10
OCR_RECOVERY_MODEL=gemini-3.5-flash-lite
