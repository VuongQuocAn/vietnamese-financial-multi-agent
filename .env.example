# File mẫu; load_data_config đọc process environment, không tự đọc .env.
# Điền trong .env cục bộ, không commit giá trị bí mật.
GEMINI_API_KEY=
# TBD: model và backend cơ sở dữ liệu chưa được chọn.
GEMINI_MODEL=
DATABASE_URL=

# Đường dẫn cục bộ gợi ý, có thể thay bằng đường dẫn ngoài repository.
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
EVIDENCE_DATA_DIR=./data/evidence
ARTIFACTS_DIR=./artifacts

# Dataset local; M1-03a dùng đúng bốn key dưới đây, không fallback từ DATA_DIR.
# Input roots bắt buộc; relative paths tính từ project_root tuyệt đối.
# Default project_root chỉ từ source checkout; bản wheel cần truyền tường minh.
FINANCIAL_REPORT_DIR=data/raw/Financial_Report
FINANCIAL_OCR_DIR=data/processed/Financial_Report_OCR
# Output roots tùy chọn (bỏ key khi chưa cấu hình, không để rỗng).
# Không được overlap input/output khác theo lexical paths; không tự tạo thư mục.
NORMALIZED_DATA_DIR=data/normalized
CANONICAL_DATA_DIR=data/canonical
